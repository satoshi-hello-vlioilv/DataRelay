# 配る zip（Release の DataRelay.zip）に入れないもの。作る側・確かめる側だけが使う。
# zip は git archive で作るので、ここに書いたものだけが外れる（.github/scripts/release.py）。
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/desktop export-ignore
/migration export-ignore
/samples export-ignore
/tests export-ignore

# Windows のバッチは CRLF・UTF-8 のまま持つ（変換すると改行が LF になり、ラベルへの goto が外れることがある）
*.cmd -text
